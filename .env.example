# Genkit / Google AI (either name works)
GOOGLE_GENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ENABLE_FIREBASE_MONITORING=true

# Leave unset locally (progress stays in data/ and journal/). Cloud sets this.
# FIELDNOTES_DATA=firestore
# Vercel sets VERCEL=1 automatically. Paste a Firebase Admin service-account JSON:
# FIREBASE_SERVICE_ACCOUNT=

# Firebase web (public client config for fieldnotes-apprenticeship)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=fieldnotes-apprenticeship.firebaseapp.com
FIREBASE_PROJECT_ID=fieldnotes-apprenticeship
FIREBASE_STORAGE_BUCKET=fieldnotes-apprenticeship.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=693921152589
FIREBASE_APP_ID=1:693921152589:web:d9884f44d3c0017524e604
