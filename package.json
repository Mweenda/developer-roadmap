{
  "name": "developer-roadmap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/firebase-fn.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "pnpm build:css && node scripts/sync-cdn-public.js",
    "build:css": "tailwindcss -i src/styles/input.css -o src/public/styles.css --minify",
