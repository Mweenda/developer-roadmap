    "test:watch": "node --test --watch test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@genkit-ai/firebase": "^1.42.0",
    "@genkit-ai/google-genai": "^1.42.0",
    "express": "^5.1.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.6.0",
    "genkit": "^1.42.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
